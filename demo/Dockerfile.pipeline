# One-shot container for the demo: generates a simulated intrusion, runs it
# through logpipe and the three detection tools, and loads the alerts into
# caseboard. Build context is the repository root.

FROM golang:1.24-bookworm AS logpipe
WORKDIR /src
COPY tools/logpipe/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/logpipe ./cmd/logpipe

FROM node:22-bookworm AS ioc-feed
WORKDIR /app
COPY tools/ioc-feed/package.json tools/ioc-feed/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tools/ioc-feed/tsconfig.json ./
COPY tools/ioc-feed/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-yaml \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /soc
COPY --from=logpipe /out/logpipe /usr/local/bin/logpipe
COPY --from=ioc-feed /app/node_modules tools/ioc-feed/node_modules
COPY --from=ioc-feed /app/dist tools/ioc-feed/dist
COPY tools/ioc-feed/package.json tools/ioc-feed/package.json
COPY tools/ioc-feed/samples tools/ioc-feed/samples
COPY tools/sigma-lite tools/sigma-lite
COPY tools/auth-anom tools/auth-anom
COPY tools/eventgen tools/eventgen
COPY demo/run_pipeline.py demo/run_pipeline.py
ENV LOGPIPE_BIN=/usr/local/bin/logpipe \
    PYTHONDONTWRITEBYTECODE=1
USER node
ENTRYPOINT ["python3", "demo/run_pipeline.py"]
