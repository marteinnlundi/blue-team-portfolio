{
  "name": "caseboard",
  "version": "0.1.0",
  "description": "Case management for alert triage and incident investigations",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/public','dist/public',{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "node": ">=22"
  }
}
